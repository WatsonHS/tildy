{
  "add_newline": true,
  "history": {
    "mode": "compact"
  },
  "layout": {
    "rows": [
      {
        "left": [
          "user",
          "cwd",
          "git",
          "c",
          "elixir",
          "elm",
          "go",
          "haskell",
          "java",
          "julia",
          "node",
          "nim",
          "rust",
          "docker",
          "time"
        ],
        "separator": {
          "ascii": ">",
          "nerd": ""
        },
        "style": "powerline"
      },
      {
        "left": [
          "char"
        ]
      }
    ]
  },
  "modules": {
    "c": {
      "language": "c",
      "style": {
        "background": "#86BBD8"
      },
      "symbol": {
        "ascii": "c",
        "nerd": "",
        "unicode": "c"
      },
      "type": "language"
    },
    "char": {
      "error_style": {
        "bold": true,
        "foreground": "red"
      },
      "success_style": {
        "bold": true,
        "foreground": "green"
      },
      "symbol": {
        "ascii": ">",
        "unicode": "❯"
      },
      "type": "character"
    },
    "cwd": {
      "style": {
        "background": "#DA627D"
      },
      "substitutions": {
        "Documents": {
          "nerd": " "
        },
        "Downloads": {
          "nerd": " "
        },
        "Music": {
          "nerd": " "
        },
        "Pictures": {
          "nerd": " "
        }
      },
      "truncation_length": 3,
      "truncation_symbol": "…/",
      "type": "directory"
    },
    "docker": {
      "style": {
        "background": "#06969A"
      },
      "symbol": {
        "ascii": "docker",
        "nerd": "",
        "unicode": "docker"
      },
      "type": "docker_context"
    },
    "elixir": {
      "detect_files": [
        "mix.exs"
      ],
      "module": "elixir",
      "style": {
        "background": "#86BBD8"
      },
      "type": "starship"
    },
    "elm": {
      "detect_extensions": [
        "elm"
      ],
      "detect_files": [
        "elm.json",
        "elm-package.json",
        ".elm-version"
      ],
      "detect_folders": [
        "elm-stuff"
      ],
      "module": "elm",
      "style": {
        "background": "#86BBD8"
      },
      "type": "starship"
    },
    "git": {
      "branch_symbol": {
        "ascii": "git",
        "nerd": "",
        "unicode": "⎇"
      },
      "status_symbols": {
        "ahead": "⇡",
        "behind": "⇣",
        "conflicted": "=",
        "deleted": "✘",
        "diverged": "⇕",
        "modified": "!",
        "renamed": "»",
        "staged": "+",
        "stashed": "$",
        "untracked": "?"
      },
      "style": {
        "background": "#FCA17D"
      },
      "type": "git"
    },
    "go": {
      "language": "golang",
      "style": {
        "background": "#86BBD8"
      },
      "symbol": {
        "ascii": "go",
        "nerd": "",
        "unicode": "go"
      },
      "type": "language"
    },
    "haskell": {
      "detect_extensions": [
        "hs",
        "cabal",
        "hs-boot"
      ],
      "detect_files": [
        "stack.yaml",
        "cabal.project"
      ],
      "module": "haskell",
      "style": {
        "background": "#86BBD8"
      },
      "type": "starship"
    },
    "java": {
      "language": "java",
      "style": {
        "background": "#86BBD8"
      },
      "symbol": {
        "ascii": "java",
        "nerd": "",
        "unicode": "java"
      },
      "type": "language"
    },
    "julia": {
      "detect_extensions": [
        "jl"
      ],
      "detect_files": [
        "Project.toml",
        "Manifest.toml"
      ],
      "module": "julia",
      "style": {
        "background": "#86BBD8"
      },
      "type": "starship"
    },
    "nim": {
      "detect_extensions": [
        "nim",
        "nims",
        "nimble"
      ],
      "detect_files": [
        "nim.cfg"
      ],
      "module": "nim",
      "style": {
        "background": "#86BBD8"
      },
      "type": "starship"
    },
    "node": {
      "language": "nodejs",
      "style": {
        "background": "#86BBD8"
      },
      "symbol": {
        "ascii": "node",
        "nerd": "",
        "unicode": "⬢"
      },
      "type": "language"
    },
    "rust": {
      "language": "rust",
      "style": {
        "background": "#86BBD8"
      },
      "symbol": {
        "ascii": "rust",
        "nerd": "",
        "unicode": "rust"
      },
      "type": "language"
    },
    "time": {
      "format": "♥ $time",
      "style": {
        "background": "#33658A"
      },
      "time_format": "%R",
      "type": "time"
    },
    "user": {
      "show_always": true,
      "style": {
        "background": "#9A348E"
      },
      "symbol": {
        "ascii": "u",
        "nerd": "",
        "unicode": ""
      },
      "type": "username"
    }
  },
  "schema_version": 1,
  "symbols": "auto"
}
