{
  "candidate": {
    "add_newline": true,
    "history": {
      "mode": "compact"
    },
    "layout": {
      "rows": [
        {
          "left": [
            "user",
            "host",
            "cwd",
            "git",
            "duration"
          ],
          "separator": ""
        },
        {
          "left": [
            "py",
            "char"
          ]
        }
      ]
    },
    "modules": {
      "char": {
        "error_style": {
          "foreground": "red"
        },
        "success_style": {
          "foreground": "magenta"
        },
        "symbol": {
          "ascii": ">",
          "unicode": "❯"
        },
        "type": "character"
      },
      "cwd": {
        "format": "[$path](fg:blue)[$read_only](fg:red) ",
        "truncation_length": 3,
        "truncation_symbol": "",
        "type": "directory"
      },
      "duration": {
        "format": "$human ",
        "show_when": {
          "field": "command.duration_ms",
          "op": "ge",
          "value": 2000
        },
        "style": {
          "foreground": "yellow"
        },
        "type": "duration"
      },
      "git": {
        "branch_symbol": {
          "ascii": "git ",
          "nerd": " ",
          "unicode": "⎇ "
        },
        "format": "[$branch](fg:8)[[(*$conflicted$untracked$modified$staged$renamed$deleted)](fg:218) ($ahead_behind$stashed)](fg:cyan)",
        "state_style": {
          "foreground": "8"
        },
        "status_symbols": {
          "ahead": "⇡",
          "behind": "⇣",
          "conflicted": "​",
          "deleted": "​",
          "diverged": "⇕",
          "modified": "​",
          "renamed": "​",
          "staged": "​",
          "stashed": "≡",
          "untracked": "​"
        },
        "type": "git"
      },
      "host": {
        "format": "[$ssh_symbol$host](bold dimmed fg:green) in ",
        "show_when": {
          "field": "session.ssh",
          "op": "eq",
          "value": true
        },
        "symbol": {
          "ascii": "ssh ",
          "unicode": "🌐 "
        },
        "type": "hostname"
      },
      "py": {
        "$comment": "detect_files [\"/\"] never matches (Starship's empty detection lists)",
        "detect_files": [
          "/"
        ],
        "format": "$env ",
        "style": {
          "foreground": "8"
        },
        "symbol": {
          "ascii": "py ",
          "unicode": "🐍 "
        },
        "type": "python"
      },
      "user": {
        "format": "[$user](bold fg:yellow) in ",
        "show_always": false,
        "type": "username"
      }
    },
    "schema_version": 1,
    "symbols": "auto"
  },
  "skipped": [],
  "unsupported": [
    {
      "item": "character.vimcmd_symbol",
      "reason": "needs the Zsh keymap, which the shell does not send yet; ignored"
    }
  ]
}
