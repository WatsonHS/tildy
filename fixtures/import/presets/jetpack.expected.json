{
  "candidate": {
    "add_newline": true,
    "history": {
      "mode": "compact"
    },
    "layout": {
      "rows": [
        {
          "left": [
            "nix_shell",
            "fill",
            "git_metrics"
          ],
          "separator": ""
        },
        {
          "left": [
            "duration",
            "host",
            "localip",
            "jobs",
            "sudo",
            "user",
            "char"
          ],
          "right": [
            "cwd",
            "git",
            "git_commit",
            "docker",
            "package",
            "c",
            "dart",
            "deno",
            "elixir",
            "go",
            "haskell",
            "java",
            "kotlin",
            "lua",
            "node",
            "php",
            "py",
            "ruby",
            "rust",
            "scala",
            "swift",
            "zig",
            "conda",
            "time"
          ],
          "separator": ""
        }
      ]
    },
    "modules": {
      "c": {
        "format": " $symbol($version)",
        "language": "c",
        "style": {
          "bold": true,
          "foreground": "149"
        },
        "symbol": {
          "ascii": "c ",
          "unicode": "ℂ "
        },
        "type": "language"
      },
      "char": {
        "error_style": {
          "foreground": "magenta",
          "italic": true
        },
        "error_symbol": {
          "ascii": ">",
          "unicode": "○"
        },
        "success_style": {
          "bold": true,
          "foreground": "11",
          "italic": true
        },
        "symbol": {
          "ascii": ">",
          "unicode": "◎"
        },
        "type": "character"
      },
      "conda": {
        "format": " conda [$symbol$env_value](bold fg:green)",
        "show_when": {
          "field": "env.CONDA_DEFAULT_ENV",
          "op": "ne",
          "value": "base"
        },
        "symbol": {
          "ascii": "conda ",
          "unicode": "◯ "
        },
        "type": "env_var",
        "variable": "CONDA_DEFAULT_ENV"
      },
      "cwd": {
        "format": "[$path](italic fg:blue)[$read_only](fg:red)",
        "home_symbol": "⌂",
        "read_only": " ◈",
        "repo_root_format": "[$before_root_path](italic fg:blue)[$repo_root](bold fg:blue)[$path](italic fg:blue)[$read_only](fg:red) [△](bold fg:12)",
        "truncation_length": 2,
        "truncation_symbol": "□ ",
        "type": "directory"
      },
      "dart": {
        "argv": [
          "dart",
          "--version"
        ],
        "detect_extensions": [
          "dart"
        ],
        "detect_files": [
          "pubspec.yaml",
          "pubspec.yml",
          "pubspec.lock"
        ],
        "detect_folders": [
          ".dart_tool"
        ],
        "format": " dart [$symbol($version )](bold fg:blue)",
        "regex": "version: (\\d+\\.\\d+\\.\\d+)",
        "symbol": {
          "ascii": "dart ",
          "unicode": "◁◅ "
        },
        "type": "command"
      },
      "deno": {
        "argv": [
          "deno",
          "-V"
        ],
        "detect_files": [
          "deno.json",
          "deno.jsonc",
          "deno.lock",
          "mod.ts",
          "mod.js",
          "deps.ts",
          "deps.js"
        ],
        "format": " [deno](italic) [∫ $version](bold fg:green)",
        "regex": "deno (\\d+\\.\\d+\\.\\d+)",
        "symbol": {
          "ascii": "deno ",
          "unicode": "🦕 "
        },
        "type": "command",
        "version_format": "${raw}"
      },
      "docker": {
        "format": " docker [$symbol$context](bold fg:blue)",
        "symbol": {
          "ascii": "docker ",
          "unicode": "◧ "
        },
        "type": "docker_context"
      },
      "duration": {
        "format": "◄ $human ",
        "show_when": {
          "field": "command.duration_ms",
          "op": "ge",
          "value": 2000
        },
        "style": {
          "foreground": "white",
          "italic": true
        },
        "type": "duration"
      },
      "elixir": {
        "argv": [
          "elixir",
          "--version"
        ],
        "detect_files": [
          "mix.exs"
        ],
        "format": " exs [$symbol $version ](bold fg:magenta)",
        "regex": "Elixir (\\d+\\.\\d+\\.\\d+)",
        "symbol": {
          "ascii": "elixir ",
          "unicode": "△ "
        },
        "type": "command"
      },
      "fill": {
        "style": {
          "bold": true,
          "foreground": "black"
        },
        "symbol": " ",
        "type": "fill"
      },
      "git": {
        "branch_symbol": {
          "ascii": "git",
          "unicode": "[△](bold italic fg:12)"
        },
        "format": "[( $branch(:$remote_branch))](italic fg:12)([⎪$ahead_behind$staged$modified$untracked$renamed$deleted$conflicted$stashed⎥](bold italic fg:12))",
        "ignore_branches": [
          "main",
          "master"
        ],
        "only_attached": true,
        "status_symbols": {
          "ahead": "[▴│[$count](bold fg:white)│](italic fg:green)",
          "behind": "[▿│[$count](bold fg:white)│](italic fg:red)",
          "conflicted": "[◪◦](italic fg:13)",
          "deleted": "[✕](italic fg:red)",
          "diverged": "[◇ ▴┤[$ahead_count](fg:white)│▿┤[$behind_count](fg:white)│](italic fg:13)",
          "modified": "[●◦](italic fg:yellow)",
          "renamed": "[◎◦](italic fg:12)",
          "staged": "[▪┤[$count](bold fg:white)│](italic fg:14)",
          "stashed": "[◃◈](italic fg:white)",
          "untracked": "[◌◦](italic fg:11)"
        },
        "truncation_length": 11,
        "truncation_symbol": "⋯",
        "type": "git"
      },
      "git_commit": {
        "format": "\\($hash$tag\\) ",
        "style": {
          "bold": true,
          "foreground": "green"
        },
        "type": "git_commit"
      },
      "git_metrics": {
        "format": "([▴$added](dimmed italic fg:green))([▿$deleted](dimmed italic fg:red))",
        "ignore_submodules": true,
        "type": "git_metrics"
      },
      "go": {
        "format": " go [$symbol($version )](bold fg:cyan)",
        "language": "golang",
        "symbol": {
          "ascii": "go ",
          "unicode": "∩ "
        },
        "type": "language"
      },
      "haskell": {
        "argv": [
          "ghc",
          "--numeric-version"
        ],
        "detect_extensions": [
          "hs",
          "cabal",
          "hs-boot"
        ],
        "detect_files": [
          "stack.yaml",
          "cabal.project"
        ],
        "format": " hs [$symbol($version )](bold fg:magenta)",
        "regex": "(\\d+(?:\\.\\d+)+)",
        "symbol": {
          "ascii": "haskell ",
          "unicode": "❯λ "
        },
        "type": "command"
      },
      "host": {
        "format": "[$ssh_symbol$host](bold dimmed fg:green) in ",
        "show_when": {
          "field": "session.ssh",
          "op": "eq",
          "value": true
        },
        "symbol": {
          "ascii": "ssh ",
          "unicode": "🌐 "
        },
        "type": "hostname"
      },
      "java": {
        "format": " java [$symbol($version )](dimmed fg:red)",
        "language": "java",
        "symbol": {
          "ascii": "java ",
          "unicode": "∪ "
        },
        "type": "language"
      },
      "jobs": {
        "format": "$symbol$number ",
        "number_threshold": 2,
        "style": {
          "foreground": "white"
        },
        "symbol": {
          "ascii": "*",
          "unicode": "[▶](italic fg:blue)"
        },
        "type": "jobs"
      },
      "kotlin": {
        "argv": [
          "kotlin",
          "-version"
        ],
        "detect_extensions": [
          "kt",
          "kts"
        ],
        "format": "via [$symbol($version )](bold fg:blue)",
        "regex": "version (\\d+\\.\\d+\\.\\d+)",
        "symbol": {
          "ascii": "kotlin ",
          "unicode": "🅺 "
        },
        "type": "command"
      },
      "localip": {
        "format": " ◯[$localipv4](bold fg:magenta)",
        "type": "localip"
      },
      "lua": {
        "argv": [
          "lua",
          "-v"
        ],
        "detect_extensions": [
          "lua"
        ],
        "detect_files": [
          ".lua-version"
        ],
        "detect_folders": [
          "lua"
        ],
        "format": " [lua](italic) [$symbol$version](bold fg:11)",
        "regex": "Lua (\\d+\\.\\d+(?:\\.\\d+)?)",
        "symbol": {
          "ascii": "lua ",
          "unicode": "⨀ "
        },
        "type": "command",
        "version_format": "${raw}"
      },
      "nix_shell": {
        "format": "[$symbol nix⎪$state⎪](bold dimmed italic fg:blue) [$name](dimmed italic fg:white)",
        "impure_msg": "[⌽](bold dimmed fg:red)",
        "pure_msg": "[⌾](bold dimmed fg:green)",
        "symbol": {
          "ascii": "nix",
          "unicode": "✶"
        },
        "type": "nix_shell",
        "unknown_msg": "[◌](bold dimmed fg:yellow)"
      },
      "node": {
        "detect_extensions": [],
        "detect_files": [
          "package-lock.json",
          "yarn.lock"
        ],
        "detect_folders": [
          "node_modules"
        ],
        "format": " [node](italic) [◫ ($version)](bold fg:10)",
        "language": "nodejs",
        "symbol": {
          "ascii": "node ",
          "nerd": " ",
          "unicode": "⬢ "
        },
        "type": "language",
        "version_format": "${raw}"
      },
      "package": {
        "format": " [pkg](dimmed italic) [$symbol$version](bold dimmed italic fg:yellow)",
        "symbol": {
          "ascii": "pkg ",
          "unicode": "◨ "
        },
        "type": "package",
        "version_format": "${raw}"
      },
      "php": {
        "argv": [
          "php",
          "-nr",
          "echo PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION.'.'.PHP_RELEASE_VERSION;"
        ],
        "detect_extensions": [
          "php"
        ],
        "detect_files": [
          "composer.json",
          ".php-version"
        ],
        "format": "via [$symbol($version )](bold fg:147)",
        "regex": "(\\d+\\.\\d+\\.\\d+)",
        "symbol": {
          "ascii": "php ",
          "unicode": "🐘 "
        },
        "type": "command"
      },
      "py": {
        "format": " [py](italic) [$symbol$version](bold fg:11)",
        "symbol": {
          "ascii": "py ",
          "unicode": "[⌉](bold fg:12)⌊ "
        },
        "type": "python",
        "version_format": "${raw}"
      },
      "ruby": {
        "argv": [
          "ruby",
          "-v"
        ],
        "detect_extensions": [
          "rb"
        ],
        "detect_files": [
          "Gemfile",
          ".ruby-version"
        ],
        "format": " [rb](italic) [$symbol$version](bold fg:red)",
        "regex": "ruby (\\d+\\.\\d+\\.\\d+)",
        "symbol": {
          "ascii": "rb ",
          "unicode": "◆ "
        },
        "type": "command",
        "version_format": "${raw}"
      },
      "rust": {
        "format": " [rs](italic) [$symbol$version](bold fg:red)",
        "language": "rust",
        "symbol": {
          "ascii": "rust ",
          "unicode": "⊃ "
        },
        "type": "language",
        "version_format": "${raw}"
      },
      "scala": {
        "argv": [
          "scalac",
          "-version"
        ],
        "detect_extensions": [
          "scala",
          "sbt",
          "sc"
        ],
        "detect_files": [
          "build.sbt",
          ".scalaenv",
          ".sbtenv",
          "build.sc"
        ],
        "detect_folders": [
          ".metals"
        ],
        "format": "via [$symbol($version )](bold fg:red)",
        "regex": "version (\\d+\\.\\d+\\.\\d+)",
        "symbol": {
          "ascii": "scala ",
          "unicode": "🆂 "
        },
        "type": "command"
      },
      "sudo": {
        "style": {
          "bold": true,
          "foreground": "13",
          "italic": true
        },
        "symbol": {
          "ascii": "sudo",
          "unicode": "⋈┈"
        },
        "type": "sudo"
      },
      "swift": {
        "argv": [
          "swift",
          "--version"
        ],
        "detect_extensions": [
          "swift"
        ],
        "detect_files": [
          "Package.swift"
        ],
        "format": " [sw](italic) [$symbol$version](bold fg:9)",
        "regex": "version (\\d+\\.\\d+(?:\\.\\d+)?)",
        "symbol": {
          "ascii": "swift ",
          "unicode": "◁ "
        },
        "type": "command",
        "version_format": "${raw}"
      },
      "time": {
        "format": " $time",
        "style": {
          "dim": true,
          "foreground": "white",
          "italic": true
        },
        "time_format": "%R",
        "type": "time"
      },
      "user": {
        "format": "⭘ $user ",
        "rules": [
          {
            "id": "root",
            "style": {
              "bold": true,
              "foreground": "magenta",
              "italic": true
            },
            "when": {
              "field": "session.username",
              "op": "eq",
              "value": "root"
            }
          }
        ],
        "show_always": false,
        "style": {
          "bold": true,
          "foreground": "11",
          "italic": true
        },
        "type": "username"
      },
      "zig": {
        "argv": [
          "zig",
          "version"
        ],
        "detect_extensions": [
          "zig"
        ],
        "format": "via [$symbol($version )](bold fg:yellow)",
        "regex": "(\\d+\\.\\d+\\.\\d+\\S*)",
        "symbol": {
          "ascii": "zig ",
          "unicode": "↯ "
        },
        "type": "command"
      }
    },
    "schema_version": 1,
    "symbols": "auto"
  },
  "skipped": [
