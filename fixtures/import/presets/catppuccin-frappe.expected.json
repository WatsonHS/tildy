{
  "candidate": {
    "add_newline": true,
    "history": {
      "mode": "compact"
    },
    "layout": {
      "rows": [
        {
          "end": {
            "ascii": "> ",
            "nerd": " "
          },
          "left": [
            "os",
            "user",
            "cwd",
            "git",
            "c",
            "rust",
            "go",
            "node",
            "php",
            "java",
            "kotlin",
            "haskell",
            "py",
            "conda",
            "time",
            "duration",
            "char"
          ],
          "separator": {
            "ascii": ">",
            "nerd": ""
          },
          "start": {
            "ascii": "",
            "nerd": "",
            "unicode": ""
          },
          "style": "powerline"
        }
      ]
    },
    "modules": {
      "c": {
        "language": "c",
        "style": {
          "background": "green",
          "foreground": "crust"
        },
        "symbol": {
          "ascii": "c",
          "nerd": "",
          "unicode": "c"
        },
        "type": "language"
      },
      "char": {
        "error_style": {
          "bold": true,
          "foreground": "red"
        },
        "padding": false,
        "success_style": {
          "bold": true,
          "foreground": "green"
        },
        "symbol": {
          "ascii": ">",
          "unicode": "❯"
        },
        "type": "character"
      },
      "conda": {
        "format": "$symbol$env_value ",
        "padding": false,
        "style": {
          "background": "sapphire",
          "foreground": "crust"
        },
        "symbol": {
          "ascii": "conda ",
          "nerd": "  ",
          "unicode": "conda "
        },
        "type": "env_var",
        "variable": "CONDA_DEFAULT_ENV"
      },
      "cwd": {
        "style": {
          "background": "peach",
          "foreground": "crust"
        },
        "substitutions": {
          "Developer": {
            "nerd": "󰲋 "
          },
          "Documents": {
            "nerd": "󰈙 "
          },
          "Downloads": {
            "nerd": " "
          },
          "Music": {
            "nerd": "󰝚 "
          },
          "Pictures": {
            "nerd": " "
          }
        },
        "truncation_length": 3,
        "truncation_symbol": "…/",
        "type": "directory"
      },
      "duration": {
        "format": "($symbol )in $human_ms ",
        "padding": false,
        "show_when": {
          "field": "command.duration_ms",
          "op": "ge",
          "value": 2000
        },
        "symbol": {
          "ascii": "",
          "nerd": "",
          "unicode": ""
        },
        "type": "duration"
      },
      "git": {
        "branch_symbol": {
          "ascii": "git",
          "nerd": "",
          "unicode": "⎇"
        },
        "status_symbols": {
          "ahead": "⇡",
          "behind": "⇣",
          "conflicted": "=",
          "deleted": "✘",
          "diverged": "⇕",
          "modified": "!",
          "renamed": "»",
          "staged": "+",
          "stashed": "$",
          "untracked": "?"
        },
        "style": {
          "background": "yellow",
          "foreground": "crust"
        },
        "type": "git"
      },
      "go": {
        "language": "golang",
        "style": {
          "background": "green",
          "foreground": "crust"
        },
        "symbol": {
          "ascii": "go",
          "nerd": "",
          "unicode": "go"
        },
        "type": "language"
      },
      "haskell": {
        "argv": [
          "ghc",
          "--numeric-version"
        ],
        "detect_extensions": [
          "hs",
          "cabal",
          "hs-boot"
        ],
        "detect_files": [
          "stack.yaml",
          "cabal.project"
        ],
        "format": "$symbol( $version)",
        "regex": "(\\d+(?:\\.\\d+)+)",
        "style": {
          "background": "green",
          "foreground": "crust"
        },
        "symbol": {
          "ascii": "haskell",
          "nerd": "",
          "unicode": "haskell"
        },
        "type": "command"
      },
      "java": {
        "language": "java",
        "style": {
          "background": "green",
          "foreground": "crust"
        },
        "symbol": {
          "ascii": "java",
          "nerd": "",
          "unicode": "java"
        },
        "type": "language"
      },
      "kotlin": {
