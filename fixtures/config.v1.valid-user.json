{
  "schema_version": 1,
  "preset": "plain",
  "$comment": "personal config",
  "symbols": "ascii",
  "modules": {
    "git": { "priority": 70 },
    "node": {
      "type": "command",
      "priority": 20,
      "argv": ["node", "--version"],
      "timeout_ms": 300,
      "cache_ttl_s": 60,
      "show_when": { "field": "cwd.has_file", "op": "eq", "value": "package.json" }
    }
  },
  "layout": {
    "rows": [
      { "left": ["cwd", "git", "ssh_host"], "right": ["elapsed", "node", "result"] }
    ]
  },
  "history": { "mode": "full" }
}
