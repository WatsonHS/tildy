{
  "$comment": "Powerlevel10k rainbow (config/p10k-rainbow.zsh, two lines, no frame): each segment on its own background, text in role fg. Left: os (bg6), directory (accent), git (ok; warn when dirty or conflicted, fg_dim while loading). Right, on the first line: ✔ (ok on surface) or ✘ code (on err), duration (warn), jobs (info on surface), virtualenv (info), user@host over SSH (warn on surface), time (bg6). ❯ on the second line.",
  "palette": "gruvbox-dark",
  "modules": {
    "os": {
      "type": "os",
      "priority": 10,
      "os_symbols": {
        "macos": {
          "nerd": "",
          "unicode": "",
          "ascii": ""
        },
        "linux": {
          "nerd": "",
          "unicode": "",
          "ascii": ""
        },
        "windows": {
          "nerd": "",
          "unicode": "",
          "ascii": ""
        },
        "freebsd": {
          "nerd": "",
          "unicode": "",
          "ascii": ""
        }
      },
      "style": {
        "foreground": "fg",
        "background": "bg6"
      }
    },
    "cwd": {
      "type": "directory",
      "priority": 100,
      "truncation_length": 5,
      "truncate_to_repo": false,
      "truncation_symbol": {
        "unicode": "…/",
        "ascii": ".../"
      },
      "symbol": {
        "nerd": ""
      },
      "format": "($symbol )$path",
      "style": {
        "foreground": "fg",
        "background": "accent",
        "bold": true
      }
    },
    "git": {
      "type": "git",
      "priority": 80,
      "branch_symbol": {
        "nerd": " ",
        "unicode": "",
        "ascii": ""
      },
      "format": "$branch_symbol$branch( $ahead_behind)( $stashed)( $conflicted)( $staged)( $modified)( $renamed)( $deleted)( $untracked)",
      "status_symbols": {
        "conflicted": "[~$count](fg:err)",
        "ahead": {
          "unicode": "⇡$count",
          "ascii": "^$count"
        },
        "behind": {
          "unicode": "⇣$count",
          "ascii": "v$count"
        },
        "diverged": {
          "unicode": "⇣$behind_count⇡$ahead_count",
          "ascii": "v$behind_count^$ahead_count"
        },
        "untracked": "?$count",
        "stashed": "*$count",
        "modified": "!$count",
        "staged": "+$count",
        "renamed": {
          "unicode": "»$count",
          "ascii": ">$count"
        },
        "deleted": {
          "unicode": "✘$count",
          "ascii": "x$count"
        }
      },
      "state_style": {
        "foreground": "err"
      },
      "style": {
        "foreground": "fg",
        "background": "ok"
      },
      "rules": [
        {
          "id": "dirty",
          "when": {
            "field": "git.state",
            "op": "in",
            "value": [
              "dirty",
              "conflicted"
            ]
          },
          "style": {
            "background": "warn"
          }
        },
        {
          "id": "not_fresh",
          "when": {
            "field": "git.freshness",
            "op": "in",
            "value": [
              "pending",
              "stale"
            ]
          },
          "style": {
            "background": "fg_dim"
          }
        }
      ]
    },
    "ok": {
      "type": "text",
      "priority": 10,
      "text": {
        "unicode": "✔",
        "ascii": "ok"
      },
      "padding": true,
      "show_when": {
        "field": "command.exit",
        "op": "eq",
        "value": 0
      },
      "style": {
        "foreground": "ok",
        "background": "surface"
      }
    },
    "status": {
      "type": "exit_status",
      "priority": 100,
      "symbol": {
        "unicode": "✘",
        "ascii": "x"
      },
      "style": {
        "foreground": "fg",
        "background": "err"
      }
    },
    "elapsed": {
      "type": "duration",
      "priority": 40,
      "symbol": {
        "nerd": ""
      },
      "format": "$human( $symbol)",
      "show_when": {
        "field": "command.duration_ms",
        "op": "ge",
        "value": 3000
      },
      "style": {
        "foreground": "fg",
        "background": "warn"
      }
    },
    "jobs": {
      "type": "jobs",
      "priority": 50,
      "symbol": {
        "nerd": "",
        "unicode": "✦",
        "ascii": "&"
      },
      "number_threshold": 1000,
      "style": {
        "foreground": "info",
        "background": "surface"
      }
    },
    "venv": {
      "$comment": "python virtualenv/conda name only; detect_files [\"/\"] never matches, so no version command runs",
      "type": "python",
      "priority": 30,
      "symbol": {
        "nerd": ""
      },
      "format": "$env( $symbol)",
      "detect_files": [
        "/"
      ],
      "style": {
        "foreground": "fg",
        "background": "info"
      }
    },
    "context": {
      "type": "hostname",
      "priority": 60,
      "show_when": {
        "field": "session.ssh",
        "op": "eq",
        "value": true
      },
      "style": {
        "foreground": "warn",
        "background": "surface"
      }
    },
    "time": {
      "type": "time",
      "priority": 10,
      "time_format": "%T",
      "symbol": {
        "nerd": ""
      },
      "format": "$time( $symbol)",
      "style": {
        "foreground": "fg",
        "background": "bg6"
      }
    },
    "char": {
      "type": "character",
      "priority": 100,
      "symbol": {
        "unicode": "❯",
        "ascii": ">"
      },
      "success_style": {
        "foreground": "ok",
        "bold": true
      },
      "error_style": {
        "foreground": "err",
        "bold": true
      }
    },
    "changes": {
      "type": "changes",
      "priority": 95,
      "style": {
        "foreground": "yellow",
        "background": "ok"
      }
    }
  },
  "layout": {
    "rows": [
      {
        "style": "powerline",
        "separator": {
          "nerd": "",
          "ascii": ""
        },
        "subseparator": {
          "nerd": "",
          "ascii": ""
        },
        "left": [
          "os",
          "cwd",
          "git",
          "changes"
        ],
        "right": [
          "ok",
          "status",
          "elapsed",
          "jobs",
          "venv",
          "context",
          "time"
        ]
      },
      {
        "left": [
          "char"
        ]
      }
    ]
  }
}
