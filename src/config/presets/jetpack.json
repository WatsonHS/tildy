{
  "schema_version": 1,
  "$comment": "Port of Starship 1.24.2's `jetpack` preset (fixtures/import/presets/jetpack.toml, imported with `tildy::import` in commands mode, then finished by hand). Differences: The conditional first line ($nix_shell$container$fill$git_metrics) is omitted: those modules have no tildy equivalent, so the line would never show. Left out on the prompt line: localip, shlvl, shell, env_var, sudo; on the right: package, kubernetes, cloud, battery and other bridge-only modules. Git branch truncation (11 chars) and the read-only marker are not supported; other languages are command modules.",
  "modules": {
    "c": {
      "format": " $symbol($version)",
      "language": "c",
      "style": {
        "bold": true,
        "foreground": "149"
      },
      "symbol": {
        "ascii": "c ",
        "unicode": "ℂ "
      },
      "type": "language",
      "priority": 20
    },
    "char": {
      "error_style": {
        "foreground": "magenta",
        "italic": true
      },
      "error_symbol": {
        "ascii": ">",
        "unicode": "○"
      },
      "success_style": {
        "bold": true,
        "foreground": "11",
        "italic": true
      },
      "symbol": {
        "ascii": ">",
        "unicode": "◎"
      },
      "type": "character",
      "priority": 100
    },
    "conda": {
      "format": " conda [$symbol$env_value](bold fg:green)",
      "show_when": {
        "field": "env.CONDA_DEFAULT_ENV",
        "op": "ne",
        "value": "base"
      },
      "symbol": {
        "ascii": "conda ",
        "unicode": "◯ "
      },
      "type": "env_var",
      "priority": 30,
      "variable": "CONDA_DEFAULT_ENV"
    },
    "cwd": {
      "home_symbol": {
        "unicode": "⌂",
        "ascii": "~"
      },
      "repo_root_format": "[$before_root_path](italic fg:blue)[$repo_root](bold fg:blue)[$path](italic fg:blue) [△](bold fg:12)",
      "style": {
        "foreground": "blue",
        "italic": true
      },
      "truncation_length": 2,
      "truncation_symbol": "□ ",
      "type": "directory",
      "priority": 100
    },
    "dart": {
      "argv": [
        "dart",
        "--version"
      ],
      "detect_extensions": [
        "dart"
      ],
      "detect_files": [
        "pubspec.yaml",
        "pubspec.yml",
        "pubspec.lock"
      ],
      "detect_folders": [
        ".dart_tool"
      ],
      "format": " dart [$symbol($version )](bold fg:blue)",
      "regex": "version: (\\d+\\.\\d+\\.\\d+)",
      "symbol": {
        "ascii": "dart ",
        "unicode": "◁◅ "
      },
      "type": "command",
      "priority": 20
    },
    "deno": {
      "argv": [
        "deno",
        "-V"
      ],
      "detect_files": [
        "deno.json",
        "deno.jsonc",
        "deno.lock",
        "mod.ts",
        "mod.js",
        "deps.ts",
        "deps.js"
      ],
      "format": " [deno](italic) [∫ $version](bold fg:green)",
      "regex": "deno (\\d+\\.\\d+\\.\\d+)",
      "symbol": {
        "ascii": "deno ",
        "unicode": "🦕 "
      },
      "type": "command",
      "priority": 20,
      "version_format": "${raw}"
    },
    "docker": {
      "format": " docker [$symbol$context](bold fg:blue)",
      "symbol": {
        "ascii": "docker ",
        "unicode": "◧ "
      },
      "type": "docker_context",
      "priority": 30
    },
    "duration": {
      "format": "◄ $human ",
      "show_when": {
        "field": "command.duration_ms",
        "op": "ge",
        "value": 2000
      },
      "style": {
        "foreground": "white",
        "italic": true
      },
      "type": "duration",
      "priority": 40
    },
    "elixir": {
      "argv": [
        "elixir",
        "--version"
      ],
      "detect_files": [
        "mix.exs"
      ],
      "format": " exs [$symbol $version ](bold fg:magenta)",
      "regex": "Elixir (\\d+\\.\\d+\\.\\d+)",
      "symbol": {
        "ascii": "elixir ",
        "unicode": "△ "
      },
      "type": "command",
      "priority": 20
    },
    "git": {
      "branch_symbol": {
        "ascii": "git",
        "unicode": "[△](bold italic fg:12)"
      },
      "format": "[( $branch)](italic fg:12)([⎪$ahead_behind$staged$modified$untracked$renamed$deleted$conflicted$stashed⎥](bold italic fg:12))",
      "ignore_branches": [
        "main",
        "master"
      ],
      "only_attached": true,
      "status_symbols": {
        "ahead": "[▴│[$count](bold fg:white)│](italic fg:green)",
        "behind": "[▿│[$count](bold fg:white)│](italic fg:red)",
        "conflicted": "[◪◦](italic fg:13)",
        "deleted": "[✕](italic fg:red)",
        "diverged": "[◇ ▴┤[$ahead_count](fg:white)│▿┤[$behind_count](fg:white)│](italic fg:13)",
        "modified": "[●◦](italic fg:yellow)",
        "renamed": "[◎◦](italic fg:12)",
        "staged": "[▪┤[$count](bold fg:white)│](italic fg:14)",
        "stashed": "[◃◈](italic fg:white)",
        "untracked": "[◌◦](italic fg:11)"
      },
      "type": "git",
      "priority": 80
    },
    "go": {
      "format": " go [$symbol($version )](bold fg:cyan)",
      "language": "golang",
      "symbol": {
        "ascii": "go ",
        "unicode": "∩ "
      },
      "type": "language",
      "priority": 20
    },
    "haskell": {
      "argv": [
        "ghc",
        "--numeric-version"
      ],
      "detect_extensions": [
        "hs",
        "cabal",
        "hs-boot"
      ],
      "detect_files": [
        "stack.yaml",
        "cabal.project"
      ],
      "format": " hs [$symbol($version )](bold fg:magenta)",
      "regex": "(\\d+(?:\\.\\d+)+)",
      "symbol": {
        "ascii": "haskell ",
        "unicode": "❯λ "
      },
      "type": "command",
      "priority": 20
    },
    "host": {
      "format": "[$symbol$host](bold dimmed fg:green) in ",
      "show_when": {
        "field": "session.ssh",
        "op": "eq",
        "value": true
      },
      "symbol": {
        "ascii": "ssh ",
        "unicode": "🌐 "
      },
      "type": "hostname",
      "priority": 60
    },
    "java": {
      "format": " java [$symbol($version )](dimmed fg:red)",
      "language": "java",
      "symbol": {
        "ascii": "java ",
        "unicode": "∪ "
      },
      "type": "language",
      "priority": 20
    },
    "jobs": {
      "format": "$symbol$number ",
      "number_threshold": 2,
      "style": {
        "foreground": "white"
      },
      "symbol": {
        "ascii": "*",
        "unicode": "[▶](italic fg:blue)"
      },
      "type": "jobs",
      "priority": 50
    },
    "kotlin": {
      "argv": [
        "kotlin",
        "-version"
      ],
      "detect_extensions": [
        "kt",
        "kts"
      ],
      "format": "via [$symbol($version )](bold fg:blue)",
      "regex": "version (\\d+\\.\\d+\\.\\d+)",
      "symbol": {
        "ascii": "kotlin ",
        "unicode": "🅺 "
      },
      "type": "command",
      "priority": 20
    },
    "lua": {
      "argv": [
        "lua",
        "-v"
      ],
      "detect_extensions": [
        "lua"
      ],
      "detect_files": [
        ".lua-version"
      ],
      "detect_folders": [
        "lua"
      ],
      "format": " [lua](italic) [$symbol$version](bold fg:11)",
      "regex": "Lua (\\d+\\.\\d+(?:\\.\\d+)?)",
      "symbol": {
        "ascii": "lua ",
        "unicode": "⨀ "
      },
      "type": "command",
      "priority": 20,
      "version_format": "${raw}"
    },
    "node": {
      "detect_extensions": [],
      "detect_files": [
        "package-lock.json",
        "yarn.lock"
      ],
      "detect_folders": [
        "node_modules"
      ],
      "format": " [node](italic) [◫ ($version)](bold fg:10)",
      "language": "nodejs",
      "symbol": {
        "ascii": "node ",
        "nerd": " ",
        "unicode": "⬢ "
      },
      "type": "language",
      "priority": 20,
      "version_format": "${raw}"
    },
    "php": {
      "argv": [
        "php",
        "-nr",
        "echo PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION.'.'.PHP_RELEASE_VERSION;"
      ],
      "detect_extensions": [
        "php"
      ],
      "detect_files": [
        "composer.json",
        ".php-version"
      ],
      "format": "via [$symbol($version )](bold fg:147)",
      "regex": "(\\d+\\.\\d+\\.\\d+)",
      "symbol": {
        "ascii": "php ",
        "unicode": "🐘 "
      },
      "type": "command",
      "priority": 20
    },
    "py": {
      "format": " [py](italic) [$symbol$version](bold fg:11)",
      "symbol": {
        "ascii": "py ",
        "unicode": "[⌉](bold fg:12)⌊ "
      },
      "type": "python",
      "priority": 30,
      "version_format": "${raw}"
    },
    "ruby": {
      "argv": [
        "ruby",
        "-v"
      ],
      "detect_extensions": [
        "rb"
      ],
      "detect_files": [
        "Gemfile",
        ".ruby-version"
      ],
      "format": " [rb](italic) [$symbol$version](bold fg:red)",
      "regex": "ruby (\\d+\\.\\d+\\.\\d+)",
      "symbol": {
        "ascii": "rb ",
        "unicode": "◆ "
      },
      "type": "command",
      "priority": 20,
      "version_format": "${raw}"
    },
    "rust": {
      "format": " [rs](italic) [$symbol$version](bold fg:red)",
      "language": "rust",
      "symbol": {
        "ascii": "rust ",
        "unicode": "⊃ "
      },
      "type": "language",
      "priority": 20,
      "version_format": "${raw}"
    },
    "scala": {
      "argv": [
        "scalac",
        "-version"
      ],
      "detect_extensions": [
        "scala",
        "sbt",
        "sc"
      ],
      "detect_files": [
        "build.sbt",
        ".scalaenv",
        ".sbtenv",
        "build.sc"
      ],
      "detect_folders": [
        ".metals"
      ],
      "format": "via [$symbol($version )](bold fg:red)",
      "regex": "version (\\d+\\.\\d+\\.\\d+)",
      "symbol": {
        "ascii": "scala ",
        "unicode": "🆂 "
      },
      "type": "command",
      "priority": 20
    },
    "swift": {
      "argv": [
        "swift",
        "--version"
      ],
      "detect_extensions": [
        "swift"
      ],
      "detect_files": [
        "Package.swift"
      ],
      "format": " [sw](italic) [$symbol$version](bold fg:9)",
      "regex": "version (\\d+\\.\\d+(?:\\.\\d+)?)",
      "symbol": {
        "ascii": "swift ",
        "unicode": "◁ "
      },
      "type": "command",
      "priority": 20,
      "version_format": "${raw}"
    },
    "time": {
      "format": " $time",
      "style": {
        "dim": true,
        "foreground": "white",
        "italic": true
      },
      "time_format": "%R",
      "type": "time",
      "priority": 10
    },
    "user": {
      "format": "⭘ $user ",
      "show_always": false,
      "style": {
        "bold": true,
        "foreground": "11",
        "italic": true
      },
      "type": "username",
      "priority": 90
    },
    "zig": {
      "argv": [
        "zig",
        "version"
      ],
      "detect_extensions": [
        "zig"
      ],
      "format": "via [$symbol($version )](bold fg:yellow)",
      "regex": "(\\d+\\.\\d+\\.\\d+\\S*)",
      "symbol": {
        "ascii": "zig ",
        "unicode": "↯ "
      },
      "type": "command",
      "priority": 20
    }
  },
  "layout": {
    "rows": [
      {
        "left": [
          "duration",
          "host",
          "jobs",
          "user",
          "char"
        ],
        "right": [
          "cwd",
          "git",
          "docker",
          "c",
          "dart",
          "deno",
          "elixir",
          "go",
          "haskell",
          "java",
          "kotlin",
          "lua",
          "node",
          "php",
          "py",
          "ruby",
          "rust",
          "scala",
          "swift",
          "zig",
          "conda",
          "time"
        ],
        "separator": ""
      }
    ]
  }
}
