{
  "schema_version": 1,
  "$comment": "Port of Starship 1.24.2's `tokyo-night` preset (fixtures/import/presets/tokyo-night.toml, imported with `tildy::import` in commands mode, then finished by hand). Differences: PHP comes from a command module (php -nr ...). Powerline separators adapt to hidden modules (Starship draws fixed separators and leaves empty color slivers); Starship's blank line before the prompt (add_newline) is not reproduced.",
  "symbols": "nerd",
  "modules": {
    "char": {
      "error_style": {
        "bold": true,
        "foreground": "red"
      },
      "success_style": {
        "bold": true,
        "foreground": "green"
      },
      "symbol": {
        "ascii": ">",
        "unicode": "❯"
      },
      "type": "character",
      "priority": 100
    },
    "cwd": {
      "style": {
        "background": "#769FF0",
        "foreground": "#E3E5E5"
      },
      "substitutions": {
        "Documents": {
          "nerd": "󰈙 "
        },
        "Downloads": {
          "nerd": " "
        },
        "Music": {
          "nerd": " "
        },
        "Pictures": {
          "nerd": " "
        }
      },
      "truncation_length": 3,
      "truncation_symbol": {
        "unicode": "…/",
        "ascii": ".../"
      },
      "type": "directory",
      "priority": 100
    },
    "git": {
      "branch_symbol": {
        "ascii": "git",
        "nerd": "",
        "unicode": "⎇"
      },
      "status_symbols": {
        "ahead": {
          "unicode": "⇡",
          "ascii": "^"
        },
        "behind": {
          "unicode": "⇣",
          "ascii": "v"
        },
        "conflicted": "=",
        "deleted": {
          "unicode": "✘",
          "ascii": "x"
        },
        "diverged": {
          "unicode": "⇕",
          "ascii": "^v"
        },
        "modified": "!",
        "renamed": {
          "unicode": "»",
          "ascii": ">"
        },
        "staged": "+",
        "stashed": "$",
        "untracked": "?"
      },
      "style": {
        "background": "#394260",
        "foreground": "#769FF0"
      },
      "type": "git",
      "priority": 80
    },
    "go": {
      "language": "golang",
      "style": {
        "background": "#212736",
        "foreground": "#769FF0"
      },
      "symbol": {
        "ascii": "go",
        "nerd": "",
        "unicode": "go"
      },
      "type": "language",
      "priority": 20
    },
    "node": {
      "language": "nodejs",
      "style": {
        "background": "#212736",
        "foreground": "#769FF0"
      },
      "symbol": {
        "ascii": "node",
        "nerd": "",
        "unicode": "⬢"
      },
      "type": "language",
      "priority": 20
    },
    "php": {
      "argv": [
        "php",
        "-nr",
        "echo PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION.'.'.PHP_RELEASE_VERSION;"
      ],
      "detect_extensions": [
        "php"
      ],
      "detect_files": [
        "composer.json",
        ".php-version"
      ],
      "format": "$symbol( $version)",
      "regex": "(\\d+\\.\\d+\\.\\d+)",
      "style": {
        "background": "#212736",
        "foreground": "#769FF0"
      },
      "symbol": {
        "ascii": "php",
        "nerd": "",
        "unicode": "php"
      },
      "type": "command",
      "priority": 20
    },
    "rust": {
      "language": "rust",
      "style": {
        "background": "#212736",
        "foreground": "#769FF0"
      },
      "symbol": {
        "ascii": "rust",
        "nerd": "",
        "unicode": "rust"
      },
      "type": "language",
      "priority": 20
    },
    "text1": {
      "style": {
        "background": "#A3AED2",
        "foreground": "#090C0C"
      },
      "text": {
        "nerd": "  "
      },
      "type": "text",
      "priority": 10
    },
    "time": {
      "style": {
        "background": "#1D2230",
        "foreground": "#A0A9CB"
      },
      "symbol": {
        "ascii": "",
        "nerd": "",
        "unicode": ""
      },
      "time_format": "%R",
      "type": "time",
      "priority": 10
    },
    "changes": {
      "type": "changes",
      "priority": 95,
      "style": {
        "foreground": "yellow",
        "background": "#394260"
      }
    }
  },
  "layout": {
    "rows": [
      {
        "left": [
          "text1",
          "cwd",
          "git",
          "changes",
          "node",
          "rust",
          "go",
          "php",
          "time"
        ],
        "separator": {
          "ascii": ">",
          "nerd": ""
        },
        "start": {
          "ascii": "",
          "nerd": "░▒▓",
          "unicode": "░▒▓"
        },
        "style": "powerline"
      },
      {
        "left": [
          "char"
        ]
      }
    ]
  }
}
